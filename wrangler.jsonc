{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "setline",
  // Static-only. The Worker that used to serve auth, private state and MCP was
  // removed when Setline became device-first with iCloud sync, so nothing here
  // needs a script, a database, or a binding.
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-05-22"
}
