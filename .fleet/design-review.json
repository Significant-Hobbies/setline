{
  "$schema": "fleet.design-review.v1",
  "version": 1,
  "project": "setline",
  "target": "Owned product changelog",
  "mode": "preserve",
  "register": "product",
  "context": {
    "product": "PRODUCT.md",
    "design": "DESIGN.md"
  },
  "direction": {
    "references": [],
    "probes": [],
    "selected": "existing-design",
    "approval": "not-required",
    "before": "artifacts/design/before.png"
  },
  "evidence": {
    "screenshots": [
      {
        "width": 390,
        "path": "artifacts/design/after-390.png"
      },
      {
        "width": 768,
        "path": "artifacts/design/after-768.png"
      },
      {
        "width": 1440,
        "path": "artifacts/design/after-1440.png"
      }
    ],
    "projectCheck": {
      "command": "npm run check && git diff --check",
      "status": "pass"
    },
    "critique": {
      "score": 36,
      "maximum": 40
    },
    "audit": {
      "score": 18,
      "maximum": 20
    },
    "unresolved": {
      "p0": 0,
      "p1": 0
    },
    "detector": {
      "posture": "advisory",
      "findings": [
        "The detector reported one pre-existing inset badge stripe in the workout UI, outside the changelog surface."
      ]
    }
  },
  "ownerFeedback": {
    "decision": "delegated",
    "note": "The owner explicitly delegated changelog implementation across all projects on 2026-07-29."
  }
}
